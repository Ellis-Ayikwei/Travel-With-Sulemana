// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  phone     String
  password  String
  profileImage String?
  bookings  Booking[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Admin {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      String     @default("admin")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId       String
  package         TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  numberOfTravelers Int
  startDate       DateTime
  endDate         DateTime
  totalPrice      Float
  status          String    @default("PENDING")
  specialRequests String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TravelPackage {
  id              String    @id @default(cuid())
  name            String
  description     String
  destination     String
  duration        Int
  price           Float
  maxTravelers    Int
  currentBookings Int       @default(0)
  highlights      String    @default("[]")
  images          String    @default("[]")
  itinerary       String    @default("[]")
  rating          Float     @default(5.0)
  reviews         Int       @default(0)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Destination {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String    @unique
  region          String
  tagline         String?
  description     String
  longDescription String?
  image           String
  gallery         String    @default("[]")
  highlights      String    @default("[]")
  duration        String?
  bestTime        String    @default("Year-round")
  thingsToDo      String    @default("[]")
  howToGetThere   String?
  whereToStay     String    @default("[]")
  localTips       String    @default("[]")
  estimatedCost   String?
  rating          Float     @default(4.8)
  reviews         Int       @default(0)
  experienceIds   String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BlogPost {
  id        String    @id @default(cuid())
  title     String
  excerpt   String
  content   String
  category  String
  author    String    @default("Sulemana")
  date      DateTime  @default(now())
  image     String
  featured  Boolean   @default(false)
  readTime  Int
  tags      String    @default("[]")
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Experience {
  id            String    @id @default(cuid())
  name          String
  category      String
  region        String
  description   String
  longDescription String?
  startDate     DateTime
  duration      String
  groupSize     String
  price         Float
  availability  Int
  tag           String
  highlights    String    @default("[]")
  thingsToDo    String    @default("[]")
  itinerary     String    @default("[]")
  inclusions    String    @default("[]")
  testimonials  String    @default("[]")
  aboutExpedition String?
  howToGetThere String?
  whereToStay   String    @default("[]")
  localTips     String    @default("[]")
  image         String
  gallery       String    @default("[]")
  icon          String?
  rating        Float     @default(4.8)
  reviews       Int       @default(0)
  destinationIds String    @default("[]")
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CarouselImage {
  id        String    @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
